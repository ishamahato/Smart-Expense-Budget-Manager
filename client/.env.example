# ---------------------------------------------------------------------------
# Client configuration. Copy to client/.env if you need to override anything.
#
# Only variables prefixed with VITE_ are exposed to the browser, and anything
# here IS public — never put a secret in this file. The Gemini key lives in
# server/.env and is only ever used server-side.
# ---------------------------------------------------------------------------

# Base URL for the API.
#
# Leave this unset in development: Vite proxies /api to the Express server
# (see vite.config.js), so requests stay same-origin and CORS never applies.
#
# Set it for a production build where the API is on a different host, e.g.
#   VITE_API_URL=https://api.your-domain.com/api
# VITE_API_URL=

# Override the dev proxy target if your API is not on the default port.
# VITE_PROXY_TARGET=http://localhost:5050
