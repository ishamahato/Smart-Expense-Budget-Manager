# ---------------------------------------------------------------------------
# Server configuration — copy to server/.env and fill in real values.
# server/.env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5050

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/smart-expense-manager
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart-expense-manager
MONGO_URI=mongodb://127.0.0.1:27017/smart-expense-manager

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5174,http://localhost:5173

# ---------------------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/app/apikey
# Optional: with no key the AI endpoints fall back to a local rules engine so
# the app stays fully usable. The key is only ever read server-side.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Recurring expense scheduler
# ---------------------------------------------------------------------------
RECURRING_CRON=true
RECURRING_CRON_SCHEDULE=0 2 * * *

# bcrypt work factor (10-14 is sensible; higher is slower but stronger)
BCRYPT_ROUNDS=12

# error | warn | info | debug
LOG_LEVEL=info
