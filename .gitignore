# Dependencies
node_modules/
.pnp
.pnp.js

# Environment — never commit real secrets.
# `.env` alone already matches at every depth (server/.env, client/.env); the
# explicit paths below are belt-and-braces so the intent survives a refactor.
# The GEMINI_API_KEY and JWT_SECRET live in server/.env and must never be
# committed — only the placeholder .env.example files are tracked.
.env
.env.*
.env.local
.env.*.local
server/.env
client/.env
!.env.example
!server/.env.example
!client/.env.example

# Other credential shapes, in case anything is ever added
*.pem
*.key
*.p12
secrets.json
credentials.json
service-account*.json

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / test output
coverage/
.nyc_output/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Local database dumps
dump/
*.bson

# Misc
.cache/
.temp/
.history/
